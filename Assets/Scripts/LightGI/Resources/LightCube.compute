#pragma kernel CSMain

#define MAX_RAYS     8          // rays cast per pixel per frame
#define MAX_STEPS    80         // max sphere-march steps per ray
#define MAX_DIST     650.0      // max light travel distance (pixels)
#define ATT_POW      1.5        // attenuation exponent
#define PI           3.14159265359
#define TAU          6.28318530718
#define GOLDEN_ANGLE (PI * 0.7639320225)
#define N_CUBES      6          // number of cubes (reduce if too slow)
#define EDGE_R       2.0        // capsule half-thickness (px); original = 1px cylinder

// Rotation speeds — analogue of p5's random(1,3) with a fixed seed.
// Tweak to change animation character.
#define SPD_ORBIT  1.7          // a: orbit angular velocity
#define SPD_ROTX   1.3          // b: rotateX speed multiplier
#define SPD_ROTY   2.1          // c: rotateY speed multiplier

RWTexture2D<float4> _Result;       // write — current frame
Texture2D<float4>   _PrevFrame;   // read  — previous frame
SamplerState        sampler_PrevFrame;

float2 _Resolution;
float  _Time;
int    _Frame;

int _MaxRay;
int _MaxStep;
int _MaxDist;
float _AttenuationPower;
int _CubeCount;
float _EdgeThickness;
float _OrbitAngularSpeed;
float _RotateXMultiplier;
float _RotateYMultiplier;

// ---------------------------------------------------------------------------
//  Rotation matrices 
// ---------------------------------------------------------------------------
float3x3 Rx(float a) {
    float c = cos(a), s = sin(a);
    return float3x3(1.0, 0.0, 0.0,
                    0.0,   c,  -s,
                    0.0,   s,   c);
}
float3x3 Ry(float a) {
    float c = cos(a), s = sin(a);
    return float3x3(  c, 0.0,   s,
                    0.0, 1.0, 0.0,
                     -s, 0.0,   c);
}

// ---------------------------------------------------------------------------
//  2D capsule SDF
// ---------------------------------------------------------------------------
float sdCap2D(float2 p, float2 a, float2 b, float r) {
    float2 pa = p - a, ba = b - a;
    return length(pa - ba * clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0)) - r;
}

// ---------------------------------------------------------------------------
//  HSL → RGB  (h,s,l each in [0,1])
//  Matches p5.js colorMode(HSL,100) with hue ÷ 100 as h
// ---------------------------------------------------------------------------
float3 hsl2rgb(float h, float s, float l) {
    float3 rgb = clamp(abs(fmod(h * 6.0 + float3(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0, 0.0, 1.0);
    return l + s * (rgb - 0.5) * (1.0 - abs(2.0 * l - 1.0));
}

// Per-pixel stochastic noise (different seed each frame for temporal AA)
float hash21(float2 p, float seed) {
    return frac(sin(dot(p + seed, float2(127.1, 311.7))) * 43758.5453);
}

// ---------------------------------------------------------------------------
//  Scene: N_CUBES rotating colored wireframe cubes
//
//  Returns: SDF to nearest edge
//  Outputs: col (linear emissive), isLight (+1 emitter, −1 occluder)
//
//  Performance note: bounding-circle early-out skips the 12 capsule evals
//  per cube when that cube is clearly not the nearest object.
// ---------------------------------------------------------------------------
float evalScene(float2 p, float t, out float3 col, out float isLight) {
    float sceneSize = min(_Resolution.x, _Resolution.y);

    // Cube parameters (both oscillate with cos(t), matching p5 original)
    float d      = (cos(t) + 1.0) * sceneSize * 0.2;       // orbit radius oscillator
    float orbR   = d + sceneSize / 20.0;                   // actual orbit radius
    float cubeR  = sceneSize * lerp(0.2, 0.1, (cos(t) + 1.0) * 0.5); // cube half-size

    // Shared rotation matrix: R = Ry(t*c*3) * Rx(t*b*3)
    // (p5 applies rotateX first, then rotateY in the same push/pop → Ry*Rx order)
    // float3x3 R = Ry(t * SPD_ROTY * 3.0) * Rx(t * SPD_ROTX * 3.0);
    float3x3 R = mul(Ry(t * _RotateYMultiplier * 3.0), Rx(t * _RotateXMultiplier * 3.0));

    // Conservative bounding radius for all 12 edges of a cube
    float boundR = cubeR * 1.8 + _EdgeThickness;

    float minD  = 1e9;
    col     = 0.0;
    isLight = 0.0;

    for (int ci = 0; ci < _CubeCount; ci++) {
        float fi     = float(ci);
        float orbAng = fi * TAU / float(_CubeCount) + t * _OrbitAngularSpeed;
        float2  orbit  = float2(cos(orbAng), sin(orbAng)) * orbR;

        // Bounding circle early-out — skip full edge check if impossible to win
        if (length(p - orbit) - boundR >= minD) continue;

        // Color: evenly spaced hues, S=1.0, L=0.6 — matching HSL(angle, 100, 60)/100
        float3 cubeCol = hsl2rgb(fi / float(_CubeCount), 1.0, 0.6);

        // 12 edges grouped by axis direction.
        // Each group: iterate over the 4 sign combinations of the two fixed coords.
        // Endpoints: float3(±sA, ±sB, −1)*cubeR → R → project → +orbit

        // --- Z-direction edges (x,y fixed; z: −cubeR → +cubeR) ---
        for (int ix = 0; ix < 2; ix++) {
            for (int iy = 0; iy < 2; iy++) {
                float sx = (ix == 0) ? -1.0 : 1.0;
                float sy = (iy == 0) ? -1.0 : 1.0;
                float2 va = mul(R, float3(sx, sy, -1.0) * cubeR).xy + orbit;
                float2 vb = mul(R, float3(sx, sy,  1.0) * cubeR).xy + orbit;
                float ed = sdCap2D(p, va, vb, _EdgeThickness);
                if (ed < minD) { minD = ed; col = cubeCol; isLight = 1.0; }
            }
        }

        // --- X-direction edges (y,z fixed; x: −cubeR → +cubeR) ---
        for (int iy = 0; iy < 2; iy++) {
            for (int iz = 0; iz < 2; iz++) {
                float sy = (iy == 0) ? -1.0 : 1.0;
                float sz = (iz == 0) ? -1.0 : 1.0;
                float2 va = mul(R, float3(-1.0, sy, sz) * cubeR).xy + orbit;
                float2 vb = mul(R, float3( 1.0, sy, sz) * cubeR).xy + orbit;
                float ed = sdCap2D(p, va, vb, _EdgeThickness);
                if (ed < minD) { minD = ed; col = cubeCol; isLight = 1.0; }
            }
        }

        // --- Y-direction edges (x,z fixed; y: −cubeR → +cubeR) ---
        for (int ix = 0; ix < 2; ix++) {
            for (int iz = 0; iz < 2; iz++) {
                float sx = (ix == 0) ? -1.0 : 1.0;
                float sz = (iz == 0) ? -1.0 : 1.0;
                float2 va = mul(R, float3(sx, -1.0, sz) * cubeR).xy + orbit;
                float2 vb = mul(R, float3(sx,  1.0, sz) * cubeR).xy + orbit;
                float ed = sdCap2D(p, va, vb, _EdgeThickness);
                if (ed < minD) { minD = ed; col = cubeCol; isLight = 1.0; }
            }
        }
    }
    return minD;
}

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID) {
    if (any(id.xy >= (uint2)_Resolution)) return;

    float2 fragCoord = id.xy + 0.5;
    float2 uv        = fragCoord / _Resolution;
    float2 p         = fragCoord - _Resolution * 0.5;
    float  t         = _Time * 0.1;

    float3 surfCol;
    float  surfLight;
    float  dSurf = evalScene(p, t, surfCol, surfLight);

    if (dSurf < 0.5) {
        _Result[id.xy] = float4(surfCol * 2.0, 1.0);
        return;
    }

    
    // ---- Radiance gathering ----
    float frameHash = frac(float(_Frame) * 0.61803398875);
    float randAngle = hash21(fragCoord / _Resolution.xy, frameHash) * TAU;
    
    // ... golden-angle ray loop (identical logic, HLSL syntax) ...
    float3 gathered = 0;
    // [loop] for (int i = 0; i < MAX_RAYS; i++) { ... }
    [loop]
    for (int i = 0; i < _MaxRay; i++) {
        float angle    = randAngle + GOLDEN_ANGLE * float(i);
        float2  dir    = float2(cos(angle), sin(angle));
        float marchDist = max(dSurf, 0.5);

        for (int s = 0; s < _MaxStep; s++) {
            if (marchDist > _MaxDist) break;

            float2  mp  = p + dir * marchDist;
            float3  col = 0;
            float isLt;
            float sd = evalScene(mp, t, col, isLt);

            if (sd < 0.5) {
                if (isLt > 0.0) {
                    float att = pow(clamp(1.0 - marchDist / _MaxDist, 0.0, 1.0), _AttenuationPower);
                    gathered += col * att;
                }
                break;
            }
            marchDist += max(sd, 0.5);
        }
    }

    float3 current = gathered / _MaxRay;
    float3 prev    = _PrevFrame.SampleLevel(sampler_PrevFrame, uv, 0).rgb;
    float  blend   = (_Frame == 0) ? 1.0 : 0.5;

    _Result[id.xy] = float4(lerp(prev, current, blend), 1.0);
}