#pragma kernel InitializeSegments
#pragma kernel AnimateSegments
#pragma kernel ReconstructFrames
#pragma kernel TessellateVertices

#include "../../Shaders/Common/Noise.hlsl"

struct SegmentData
{
    float3 position;
    float3 direction;
    float3 normal;
};

struct VertexData
{
    float3 position;
    float3 normal;
    float2 uv;
};

StructuredBuffer<float3> _InitialPositionBuffer;
RWStructuredBuffer<SegmentData> _SegmentBuffer;
RWStructuredBuffer<VertexData> _VertexBuffer;

int _MaxSegment;
int _SidesPerRing;
float _TubeRadius;
float _VisibleLength;
float _CenterlineNoiseScale;
float _CenterlineStep;
int _TrailCount;
int _TotalVertexCount;
float3 _NoiseOffset;

static const float kEpsilon = 1e-5;

float3 SafeNormalize(float3 value, float3 fallback)
{
    float lengthSq = dot(value, value);
    return lengthSq > kEpsilon ? value * rsqrt(lengthSq) : fallback;
}

// Keijiro's Swarm constructs a smooth divergence-free field from the cross
// product of two simplex-noise gradients. SimplexNoiseGrad returns
// gradient.xyz and noise value in w.
float3 SwirlField(float3 position)
{
    float3 samplePosition = position * _CenterlineNoiseScale + _NoiseOffset;
    float3 gradientA = SimplexNoiseGrad(98.4898 + samplePosition).xyz;
    float3 gradientB = SimplexNoiseGrad(1.2278 - samplePosition).xyz;
    return cross(gradientA, gradientB);
}

void GenerateTrail(uint trailIndex)
{
    if (trailIndex >= (uint)_TrailCount)
        return;

    uint ringCount = (uint)(_MaxSegment + 1);
    uint baseIndex = trailIndex * ringCount;
    float3 position = _InitialPositionBuffer[trailIndex];

    SegmentData segment;
    segment.position = position;
    segment.direction = float3(0, 0, 1);
    segment.normal = float3(0, 1, 0);
    _SegmentBuffer[baseIndex] = segment;

    for (uint segmentIndex = 1; segmentIndex < ringCount; segmentIndex++)
    {
        position += SwirlField(position) * _CenterlineStep;
        segment.position = position;
        _SegmentBuffer[baseIndex + segmentIndex] = segment;
    }
}

float3 InitialNormal(float3 tangent, float3 position)
{
    float3 reference = SafeNormalize(position, float3(0, 1, 0));
    float3 binormal = cross(tangent, reference);

    if (dot(binormal, binormal) <= kEpsilon)
    {
        reference = abs(tangent.y) < 0.95 ? float3(0, 1, 0) : float3(1, 0, 0);
        binormal = cross(tangent, reference);
    }

    binormal = SafeNormalize(binormal, float3(1, 0, 0));
    return SafeNormalize(cross(binormal, tangent), float3(0, 1, 0));
}

[numthreads(64, 1, 1)]
void InitializeSegments(uint trailIndex : SV_DispatchThreadID)
{
    GenerateTrail(trailIndex);
}

[numthreads(64, 1, 1)]
void AnimateSegments(uint trailIndex : SV_DispatchThreadID)
{
    GenerateTrail(trailIndex);
}

[numthreads(64, 1, 1)]
void ReconstructFrames(uint trailIndex : SV_DispatchThreadID)
{
    if (trailIndex >= (uint)_TrailCount)
        return;

    uint ringCount = (uint)(_MaxSegment + 1);
    uint baseIndex = trailIndex * ringCount;

    SegmentData first = _SegmentBuffer[baseIndex];
    SegmentData second = _SegmentBuffer[baseIndex + 1];
    float3 tangent = SafeNormalize(second.position - first.position, float3(0, 0, 1));
    float3 normal = InitialNormal(tangent, first.position);
    float3 binormal = SafeNormalize(cross(tangent, normal), float3(1, 0, 0));

    first.direction = tangent;
    first.normal = normal;
    _SegmentBuffer[baseIndex] = first;

    for (uint segmentIndex = 1; segmentIndex < ringCount - 1; segmentIndex++)
    {
        uint index = baseIndex + segmentIndex;
        float3 previousPosition = _SegmentBuffer[index - 1].position;
        float3 nextPosition = _SegmentBuffer[index + 1].position;

        tangent = SafeNormalize(nextPosition - previousPosition, tangent);
        normal = SafeNormalize(cross(binormal, tangent), normal);
        binormal = SafeNormalize(cross(tangent, normal), binormal);

        SegmentData segment = _SegmentBuffer[index];
        segment.direction = tangent;
        segment.normal = normal;
        _SegmentBuffer[index] = segment;
    }

    uint lastIndex = baseIndex + ringCount - 1;
    SegmentData previous = _SegmentBuffer[lastIndex - 1];
    SegmentData last = _SegmentBuffer[lastIndex];
    tangent = SafeNormalize(last.position - previous.position, tangent);
    normal = SafeNormalize(cross(binormal, tangent), normal);
    last.direction = tangent;
    last.normal = normal;
    _SegmentBuffer[lastIndex] = last;
}

[numthreads(64, 1, 1)]
void TessellateVertices(uint vertexIndex : SV_DispatchThreadID)
{
    if (vertexIndex >= (uint)_TotalVertexCount)
        return;

    uint ringCount = (uint)(_MaxSegment + 1);
    uint sidesPerRing = (uint)_SidesPerRing;
    uint verticesPerTrail = ringCount * sidesPerRing;
    uint trailIndex = (uint)floor(vertexIndex / (float)verticesPerTrail);
    uint localVertexIndex = vertexIndex - trailIndex * verticesPerTrail;
    uint segmentIndex = (uint)floor(localVertexIndex / (float)sidesPerRing);
    uint sideIndex = localVertexIndex - segmentIndex * sidesPerRing;

    int lastVisibleSegment = clamp((int)floor(saturate(_VisibleLength) * _MaxSegment), 0, _MaxSegment);
    int sourceSegment = min((int)segmentIndex, lastVisibleSegment);
    SegmentData segment = _SegmentBuffer[trailIndex * ringCount + (uint)sourceSegment];

    float sideT = sideIndex / (float)sidesPerRing;
    float angle = sideT * 6.28318530718;
    float3 radial = segment.normal * cos(angle) + normalize(cross(segment.direction, segment.normal)) * sin(angle);

    VertexData vertex;
    vertex.position = segment.position + radial * _TubeRadius;
    vertex.normal = normalize(radial);
    vertex.uv = float2(segmentIndex / (float)_MaxSegment, sideT);
    _VertexBuffer[vertexIndex] = vertex;
}
