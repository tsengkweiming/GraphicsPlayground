// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel InitPoints
#pragma kernel BuildLine
#pragma kernel CSMain

struct LineSegment {
    float2 p0;
    float2 p1;
    float3 emissiveColor;
};

#include "../../Common/Matrix.hlsl"
#include "../../Common/Random.hlsl"

#ifndef PI
#define PI 3.14159265359
#endif

float4 _Resoultion;
RWTexture2D<float4> _Result : register(u0);
RWStructuredBuffer<float2> _PointDataBuffer : register(u1);
RWStructuredBuffer<float> _AngleData : register(u2);
RWStructuredBuffer<LineSegment> _LineSegmentBuffer;
RWStructuredBuffer<uint> _AngleBuffer;

int _NumPoints;
int N;

float mod(float x, float y)
{
    return x - y * floor(x / y);
}

// const float gridSize = 0.3;
float2 gridPoint(uint id, uint n)
{
    float i = float(id % 3u);
    float j = float(id / 3u);
    float2 gId = float2(i,j);
    float2 gId1 = float2(i+1.2,j-0.9);
    float2 gId2 = float2(i-0.5,j+0.3);
    float rnd0 = nrand(gId)* nrand(gId);
    float rnd1 = nrand(gId1)* nrand(gId1);
    float rnd2 = nrand(gId2)* nrand(gId2);
    const float gridSize = 0.3;

    return
    n == 0 ? float2(gridSize*(i+lerp(rnd0,0.,.25)), gridSize*(j+1.)) : 
    n == 1 ? float2(gridSize*(i+lerp(rnd0,1.,.75)), gridSize*(j+1.)) : 
    n == 2 ? float2(gridSize*(i+1.), gridSize*(j+lerp(rnd1,1.,.75))) : 
    n == 3 ? float2(gridSize*(i+1.), gridSize*(j+lerp(rnd2,0.,.25))) : float2(0,0);
}

