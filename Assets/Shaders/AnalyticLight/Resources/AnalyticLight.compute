void sortAngles(float2 fragCoord)
{
    // 先初始化，避免殘值
    // [unroll] for (int i=0;i<40;++i) angles[i] = 1e20;

    [unroll]
    for (int i = 0; i < 20; ++i)
    {
        for (int j = 0; j < 2; ++j)
        {
            int k = 2 * i + j;

            float2 p = (j==0 ? _LineSegmentBuffer[i].p0 : _LineSegmentBuffer[i].p1) - fragCoord;
            float angle = atan2(p.y, p.x);
            if (angle < 0) angle += 2.0 * PI;

            int l = k - 1;

            bool inserted = false;
            for (int t = l; t >= 0; --t)
            {
                if (angle >= angles[t])
                {
                    angles[t + 1] = angle;
                    inserted = true;
                    break;
                }

                angles[t + 1] = angles[t];

                if (t == 0)
                {
                    angles[0] = angle;
                    inserted = true;
                    break;
                }
            }

            // ✅ 這一行就是你少的 GLSL 行為：k==0 時會走到這裡
            if (!inserted)
                angles[0] = angle;
        }
    }
}

